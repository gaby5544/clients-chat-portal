{
  "id": "/",
  "name": "Vistra Transaction Desk",
  "short_name": "Vistra",
  "description": "Secure escrow transactions, live payment tracking and withdrawals.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0e18",
  "theme_color": "#0a0e18",
  "lang": "en",
  "categories": [
    "finance",
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Sign in",
      "short_name": "Sign in",
      "url": "/?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Install guide",
      "short_name": "Install",
      "url": "/install"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-1.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Sign in or create your account"
    },
    {
      "src": "/screenshots/narrow-2.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Choose how you take part"
    },
    {
      "src": "/screenshots/wide-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Works beautifully on computers"
    }
  ]
}